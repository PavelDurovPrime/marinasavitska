# Normalize line endings for all text files to LF on checkout
* text=auto

*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.txt    text eol=lf
*.md     text eol=lf

# Binary files — no modifications
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.mp4    binary
*.MP4    binary
*.webp   binary
*.woff   binary
*.woff2  binary
